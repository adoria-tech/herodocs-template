{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build index and validate HeroDocs",
      "type": "shell",
      "command": "if [ -x .venv/bin/python3 ]; then P=.venv/bin/python3; else P=python3; fi; $P scripts/build_index.py && $P scripts/validate.py",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "herodocs",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    }
  ]
}
