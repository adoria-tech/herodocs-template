{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Reference",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^SRC-\\d{3,}$", "description": "e.g. SRC-001"},
    "title": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "description": "Recipe ID if this record came from a recipe"},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "type": {"enum": ["meeting", "document", "email", "notes", "guidance", "rfp", "other"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD"},
    "url": {"type": "string", "minLength": 1},
    "raw_text": {"type": "string", "minLength": 1}
  },
  "required": ["id", "title", "type", "date", "url"],
  "additionalProperties": false
}
