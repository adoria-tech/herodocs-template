{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Decision",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^DD-\\d{3,}$", "description": "e.g. DD-001"},
    "title": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "description": "Recipe ID if this record came from a recipe"},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"enum": ["proposed", "decided", "superseded"]},
    "decided_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD"},
    "requirements": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REQ-\\d{3,}$", "description": "e.g. REQ-001"},
      "uniqueItems": true
    },
    "supersedes": {"type": "string", "pattern": "^DD-\\d{3,}$", "description": "e.g. DD-001"}
  },
  "required": ["id", "title", "status"],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {"const": "decided"}
    },
    "required": ["status"]
  },
  "then": {"required": ["decided_on"]}
}
