{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^REQ-\\d{3,}$", "description": "e.g. REQ-001"},
    "title": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "description": "Recipe ID if this record came from a recipe"},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"enum": ["draft", "review", "approved", "declined"]},
    "priority": {"enum": ["must", "should", "could"]},
    "area": {"type": "string", "minLength": 1, "description": "Capability area from the areas list in project.yaml"},
    "module": {"type": "string", "minLength": 1, "description": "Zoho module, once known"},
    "sources": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SRC-\\d{3,}$", "description": "e.g. SRC-001"},
      "uniqueItems": true,
      "minItems": 1
    },
    "approved_by": {"type": "string", "minLength": 1},
    "approved_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD"}
  },
  "required": ["id", "title", "status", "priority", "area", "sources"],
  "additionalProperties": false
}
