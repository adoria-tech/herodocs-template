{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI Group",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^CG-\\d{3,}$", "description": "e.g. CG-001"},
    "title": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "description": "Recipe ID if this record came from a recipe"},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "clickup_tasks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "required": ["id", "title"],
  "additionalProperties": false
}
